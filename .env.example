# ==========================================================
# TokoKelontong — Environment Variables
# ==========================================================
# JANGAN menyimpan nilai rahasia di dalam repository.
# Di Vercel: Project Settings -> Environment Variables.
# Di Freebuff Sites: Sites -> Secrets (untuk deployment).

# Akun admin awal (dipakai saat database masih kosong).
# Pada deployment produksi nilai ini WAJIB diisi dengan password
# yang kuat. Password di-hash sebelum disimpan ke database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mode demo: aktifkan hanya di lingkungan demo/preview.
# Bila bernilai 1, aplikasi membuat akun demo admin/admin beserta
# data contoh sehingga dashboard tidak kosong.
# JANGAN aktifkan di produksi.
DEMO_MODE=

# Nama toko yang tampil pada aplikasi (opsional, bisa diubah dari
# halaman Pengaturan).
# STORE_NAME=Toko Kelontong Berkah
