# ==========================================================
# TokoKelontong — Environment Variables (Vercel)
# ==========================================================
# JANGAN menyimpan nilai rahasia di dalam repository.
# Di Vercel: Project Settings -> Environment Variables.
# Hanya variabel yang diawali NEXT_PUBLIC_ yang sampai ke browser;
# semua nilai di bawah ini hanya dibaca di server.

# Connection string PostgreSQL (Supabase).
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Gunakan "Connection pooling" (port 6543) untuk deployment serverless,
# atau "Direct connection" (port 5432) bila memakai Supavisor session mode.
# Contoh:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Opsional, maksimum koneksi per instance fungsi (default 1).
# DATABASE_POOL_MAX=1

# Akun admin awal (dipakai saat database masih kosong).
# Pada deployment produksi nilai ini WAJIB diisi dengan password kuat
# (minimal 8 karakter). Password di-hash sebelum disimpan ke database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mode demo: aktifkan hanya di lingkungan demo/preview.
# Bila bernilai 1, aplikasi membuat akun demo admin/admin beserta data
# contoh sehingga dashboard tidak kosong. JANGAN aktifkan di produksi.
DEMO_MODE=
